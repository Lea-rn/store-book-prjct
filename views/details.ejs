<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>details</title>

    <style>
      .card-container {
        display: flex;
        flex-direction: row;
      }
      img {
        margin-right: 100px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="card-container">
        <img height="600px" src="/uploads/<%= bookDetails.image %>" alt="" />
        <div>
          <h1><%= bookDetails.title %></h1>
          <h4><%= bookDetails.author %></h4>
          <p><%= bookDetails.price %></p>
          <p><%= bookDetails.description %></p>
        </div>
      </div>
    </div>
  </body>
</html>
