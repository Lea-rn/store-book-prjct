<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <style>
      form {
        width: 70%;
        margin: 100px auto;
     border-radius: 10px;
        text-align: center;
        box-shadow: 1px 1px 10px black;
        padding: 40px 0px;
      }
      input {
        margin: 20px 0px;
        text-align: center;
        border-radius: 10px;
        width: 50%;
        padding: 10px 0px;
        margin-left: 15px;
      }
      label {
        font-weight: 700;
      }
    </style>
  </head>
  <body>
    <br />
    <br />
    <br />
    <br />

    <form
      method="post"
      action="/update/<%= book._id %>"
      enctype="multipart/form-data"
    >
      <div class="mb-3">
        <label for="exampleInputEmail1" class="form-label">Title :</label>
        <input
          type="text"
          class="form-control"
          id="exampleInputEmail1"
          aria-describedby="emailHelp"
          name="title"
          value="<%= book.title %>"
        />
      </div>
      <div class="mb-3">
        <label for="exampleInputPassword1" class="form-label"
          >Descrption :</label
        >
        <input
          type="text"
          class="form-control"
          name="description"
          id="exampleInputPassword1"
          value="<%= book.description %>"
        />
      </div>

      <div class="mb-3">
        <label for="exampleInputPassword10" class="form-label">Price :</label>
        <input
          type="number"
          name="price"
          class="form-control"
          id="exampleInputPassword10"
          value="<%= book.price %>"
        />
      </div>

      <div class="mb-3">
        <label for="exampleInputPassword11" class="form-label">Author :</label>
        <input
          type="text"
          name="author"
          class="form-control"
          id="exampleInputPassword11"
          value="<%= book.author %>"
        />
      </div>

<% if (book.image) { %>
    <p>current image :</p>
      <img
        height="100px"
        class="current-image"
        src="/uploads/<%=book.image %>"
        alt=""
      />
<% } %>

  

      <div class="mb-3">
        <label for="exampleInputPassword111" class="form-label">Image :</label>
        <input
          type="file"
          name="image"
          class="form-control"
          id="exampleInputPassword111"
        />
      </div>
      <button type="submit" class="btn btn-primary">update Book</button>
    </form>
  </body>
</html>
